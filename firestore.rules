rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    function isNotBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && isNotBanned();
      allow update, delete: if signedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if owns(userId) || isAdmin();
    }

    match /users/{userId}/saved/{listingId} {
      allow read, write: if owns(userId);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && isNotBanned();
      allow read, update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read, write: if signedIn() && isNotBanned() && request.auth.uid in resource.data.memberIds;
      match /messages/{messageId} {
        allow read, create: if signedIn() && isNotBanned() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
      }
    }
  }
}
